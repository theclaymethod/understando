{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/theclaymethod/understando/schema/trust-map.schema.json",
  "title": "understando trust map",
  "description": "Claims, verifiers, controls and verdicts for one PR. scripts/validate.py reads this file and applies it, plus the cross-reference rules in its docstring.",
  "type": "object",
  "required": [
    "schema_version",
    "repo",
    "pr",
    "base",
    "head",
    "author_family",
    "claims",
    "verifiers",
    "controls"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "pr": {
      "type": [
        "integer",
        "null"
      ]
    },
    "title": {
      "type": "string"
    },
    "base": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "head": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "author_family": {
      "type": [
        "string",
        "null"
      ],
      "description": "Model family of the agent that wrote the PR, for example anthropic. Null when a human wrote it."
    },
    "created_at": {
      "type": "string"
    },
    "narrative": {
      "type": "string",
      "description": "Where the PR narrative came from."
    },
    "setup": {
      "type": "array",
      "description": "Commands that prepare a fresh worktree before a verifier runs. They run without the env file.",
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "verifiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/verifier"
      }
    },
    "controls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/control"
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/flag"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Formal": {
          "type": "integer"
        },
        "Proven": {
          "type": "integer"
        },
        "Backed": {
          "type": "integer"
        },
        "Asserted": {
          "type": "integer"
        },
        "Gap": {
          "type": "integer"
        }
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "glossary": {
      "type": "array",
      "description": "Strict STE. The words a reader must know to read the plain text of the claims.",
      "items": {
        "type": "object",
        "required": [
          "term",
          "meaning"
        ],
        "additionalProperties": false,
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Other forms of the term that the page uses, for example a plural or an acronym."
          }
        }
      }
    },
    "verdict_intros": {
      "type": "object",
      "description": "Strict STE. One line for each verdict group in the explainer.",
      "additionalProperties": false,
      "properties": {
        "Proven": {
          "type": "string",
          "minLength": 1
        },
        "Backed": {
          "type": "string",
          "minLength": 1
        },
        "Asserted": {
          "type": "string",
          "minLength": 1
        },
        "Gap": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "promises": {
      "type": "array",
      "description": "Strict STE. Three to six plain promises that the PR makes. Each claim belongs to exactly one promise. The strength of a promise is the verdict of its weakest claim; explain.py derives it, and the map never stores it.",
      "items": {
        "$ref": "#/$defs/promise"
      }
    },
    "exercises": {
      "type": "array",
      "description": "Optional. Exercises for understando learn that need fields the claims do not hold: the steps and answers of a trace, and the test path, command and planted bug of a close-gap exercise. The app derives predict, find-the-line and explain-it-back exercises from the controls and claims.",
      "items": {
        "$ref": "#/$defs/exercise"
      }
    },
    "probed_at": {
      "type": "string",
      "description": "When probe last ran controls. understando signals reports it."
    },
    "ready": {
      "type": "object",
      "description": "The branch understando/<pr>-ready in the reviewed repo, where close and trim commit. Never the PR's own commits.",
      "required": [
        "branch",
        "head"
      ],
      "additionalProperties": false,
      "properties": {
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "head": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "invariants": {
      "type": "array",
      "description": "Invariants from understando discover. journal.jsonl is the source of truth; discover copies each decision here. Only author user with status accepted can back Proven or Formal.",
      "items": {
        "$ref": "#/$defs/invariant"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9_.-]*$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "Formal",
        "Proven",
        "Backed",
        "Asserted",
        "Gap"
      ]
    },
    "codeRef": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "claim": {
      "type": "object",
      "required": [
        "id",
        "text",
        "stated",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "cc_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "The Code Contracts @cc ID, when one exists."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "Strict STE. One thing the PR asserts."
        },
        "stated": {
          "type": "boolean",
          "description": "True when the PR narrative states the claim."
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "type": "string",
          "description": "Group name for the explainer overview."
        },
        "code": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/codeRef"
          }
        },
        "verdict": {
          "$ref": "#/$defs/verdict"
        },
        "reason": {
          "type": "string"
        },
        "plain": {
          "type": "object",
          "description": "Strict STE for a reader who does not know the code.",
          "required": [
            "what",
            "proof"
          ],
          "additionalProperties": false,
          "properties": {
            "what": {
              "type": "string",
              "minLength": 1,
              "description": "What it is: the rule that the claim states."
            },
            "proof": {
              "type": "string",
              "minLength": 1,
              "description": "How it is proven: the check and the control result."
            },
            "warning": {
              "type": "string",
              "minLength": 1,
              "description": "A limit on the proof, when one exists."
            }
          }
        },
        "tier": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 5,
          "description": "verdicts.py writes it: the highest ladder rung of a verifier that went red on a control. A rung of 4 or 5 also needs a passing conformance link."
        },
        "tier_target": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "The strongest practical rung for this claim, chosen in build step 2 or by close."
        },
        "waiver": {
          "type": "object",
          "description": "close option 7. The claim stays open in the verdicts, and the ready checklist and the PR body show the reason.",
          "required": [
            "reason",
            "at"
          ],
          "additionalProperties": false,
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "at": {
              "type": "string"
            }
          }
        },
        "invariant": {
          "$ref": "#/$defs/id",
          "description": "The invariant that this claim states. Proven and Formal need a stated claim or a link to an invariant that the user confirmed."
        }
      }
    },
    "command": {
      "type": "object",
      "required": [
        "argv"
      ],
      "additionalProperties": false,
      "properties": {
        "cwd": {
          "type": "string",
          "description": "Relative to the worktree root."
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "env_file": {
          "type": "boolean",
          "description": "True: source the --env-file before the command."
        },
        "timeout_s": {
          "type": "integer",
          "minimum": 1
        },
        "red_exits": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "Exit codes that mean the verifier found a defect. Other non-zero codes mean error. The default is [1]."
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "green",
            "red",
            "error",
            "skipped"
          ]
        },
        "exit": {
          "type": [
            "integer",
            "null"
          ]
        },
        "seconds": {
          "type": "number"
        },
        "output_tail": {
          "type": "string"
        },
        "matched": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "ran_at": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "recorded": {
          "type": "boolean",
          "description": "The result comes from a past run, for example a proof control, and probe keeps it."
        }
      }
    },
    "verifier": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "claims",
        "tier",
        "description",
        "independence",
        "cost",
        "provenance"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "boundary",
            "contract",
            "contract-format",
            "e2e",
            "eval",
            "fuzz",
            "golden",
            "integration",
            "lean",
            "measurement",
            "model",
            "parity",
            "property",
            "static",
            "tla",
            "type-pin",
            "unit"
          ]
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "tier": {
          "type": "string",
          "enum": [
            "fact",
            "guess"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Strict STE."
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "recorded": {
          "type": "object",
          "description": "Evidence that understando records and does not run again, for example an eval.",
          "required": [
            "source",
            "result"
          ],
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "string"
            },
            "result": {
              "type": "string"
            },
            "at": {
              "type": "string"
            }
          }
        },
        "independence": {
          "type": "object",
          "required": [
            "by"
          ],
          "additionalProperties": false,
          "properties": {
            "by": {
              "type": "string",
              "enum": [
                "tool",
                "model",
                "human"
              ]
            },
            "tool": {
              "type": "string"
            },
            "family": {
              "type": "string",
              "description": "Model family, for example openai or anthropic."
            },
            "context": {
              "type": "string",
              "enum": [
                "fresh",
                "shared"
              ]
            }
          }
        },
        "cost": {
          "type": "object",
          "required": [
            "usd"
          ],
          "additionalProperties": false,
          "properties": {
            "usd": {
              "type": [
                "number",
                "null"
              ]
            },
            "seconds": {
              "type": [
                "number",
                "null"
              ]
            },
            "note": {
              "type": "string"
            }
          }
        },
        "provenance": {
          "type": "string",
          "minLength": 1
        },
        "baseline": {
          "$ref": "#/$defs/result"
        },
        "state": {
          "type": "string",
          "enum": [
            "proven",
            "cannot-fail",
            "untested",
            "recorded",
            "failing",
            "broken",
            "checked",
            "stale"
          ]
        },
        "mechanical": {
          "type": "object",
          "description": "A cheap check that reads Git objects only: a grep at the head or a line count of the diff. scripts/mechanical.py runs it and records the result.",
          "required": [
            "op",
            "paths"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "type": "string",
              "enum": [
                "grep-absent",
                "grep-present",
                "net-lines"
              ]
            },
            "paths": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Git pathspecs."
            },
            "pattern": {
              "type": "string",
              "minLength": 1,
              "description": "Extended regex for git grep -E."
            },
            "expect": {
              "type": "integer",
              "description": "net-lines: the net line change that the claim states."
            },
            "result": {
              "type": "object",
              "required": [
                "status",
                "detail",
                "command"
              ],
              "additionalProperties": false,
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "pass",
                    "fail"
                  ]
                },
                "detail": {
                  "type": "string"
                },
                "command": {
                  "type": "string"
                },
                "head": {
                  "type": "string"
                },
                "ran_at": {
                  "type": "string"
                }
              }
            }
          }
        },
        "ladder": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Overrides the rung that verdicts.py takes from the kind."
        },
        "at": {
          "type": "string",
          "minLength": 1,
          "description": "The commit where the verifier runs, when it is not the PR head: a commit on the ready branch."
        },
        "test": {
          "type": "object",
          "description": "Where the test lives, so trim can delete or convert it. trim reads the unittest or pytest argv when this is absent.",
          "required": [
            "path"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "formal": {
          "type": "object",
          "description": "A tier 4 or 5 verifier: the model or proof, and its conformance link to the real code.",
          "required": [
            "tool",
            "artifact",
            "conformance"
          ],
          "additionalProperties": false,
          "properties": {
            "tool": {
              "type": "string",
              "enum": [
                "lean",
                "tla",
                "apalache"
              ]
            },
            "artifact": {
              "type": "string",
              "minLength": 1,
              "description": "The proof or model file, relative to the repo root."
            },
            "conformance": {
              "type": "object",
              "required": [
                "status",
                "source"
              ],
              "additionalProperties": false,
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "pass",
                    "fail"
                  ]
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "detail": {
                  "type": "string"
                },
                "verifier": {
                  "$ref": "#/$defs/id"
                },
                "at": {
                  "type": "string"
                }
              }
            }
          }
        },
        "red_first": {
          "type": "object",
          "description": "build step 3: the verifier went red before the code existed, on the current code or a stub.",
          "required": [
            "status",
            "at"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "green",
                "red",
                "error"
              ]
            },
            "at": {
              "type": "string"
            },
            "exit": {
              "type": [
                "integer",
                "null"
              ]
            },
            "output_tail": {
              "type": "string"
            },
            "ran_at": {
              "type": "string"
            }
          }
        },
        "import": {
          "type": "object",
          "description": "Outside evidence that understando import recorded. A file that fails its format check, or changed after the import, is stale and backs nothing.",
          "required": [
            "kind",
            "path",
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "show-me-your-work",
                "lean",
                "verify-feature",
                "nemesis-review",
                "evo",
                "impeccable"
              ]
            },
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "ok",
                "stale"
              ]
            },
            "detail": {
              "type": "string"
            },
            "checked_at": {
              "type": "string"
            }
          }
        },
        "formal_record": {
          "type": "object",
          "description": "The artifact record of a formal sidecar (runs/<repo>/<pr>/formal/verifiers.json, schema understando.formal/1), as `understando formalize --sidecar` copies it. A rung 4 or 5 verifier with a record proves its claims only when formal.verdict is Formal.",
          "additionalProperties": true,
          "properties": {
            "ladder_tier": {
              "type": "integer",
              "minimum": 2,
              "maximum": 5
            },
            "conformance": {
              "type": "object"
            },
            "controls": {
              "type": "array"
            },
            "route": {
              "type": "string"
            },
            "invariant": {
              "type": "object"
            },
            "witness": {
              "type": [
                "object",
                "null"
              ]
            },
            "drift": {
              "type": "object"
            },
            "formal": {
              "type": "object",
              "required": [
                "verdict"
              ],
              "properties": {
                "verdict": {
                  "type": "string"
                },
                "missing": {
                  "type": "array"
                }
              }
            },
            "sidecar": {
              "type": "string"
            }
          }
        },
        "incomplete": {
          "type": "string",
          "minLength": 1,
          "description": "A case of the claim that this verifier does not test."
        }
      }
    },
    "edit": {
      "type": "object",
      "required": [
        "op",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "replace",
            "corrupt-byte",
            "delete-file",
            "append"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "find": {
          "type": "string"
        },
        "replace": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "offset": {
          "type": "integer"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "control": {
      "type": "object",
      "required": [
        "id",
        "verifier",
        "recipe",
        "description",
        "edits",
        "expect"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "verifier": {
          "$ref": "#/$defs/id"
        },
        "recipe": {
          "type": "string",
          "enum": [
            "remove-guard-line",
            "invert-condition",
            "remove-type-pin",
            "drop-allowlist-row",
            "corrupt-golden-byte",
            "remove-covered-code",
            "plant-violation"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Strict STE."
        },
        "edits": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/edit"
          }
        },
        "expect": {
          "type": "object",
          "required": [
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "red"
              ]
            },
            "pattern": {
              "type": "string",
              "description": "Regex that the red output must hold. A red run without it is an error: red for the wrong reason."
            }
          }
        },
        "result": {
          "$ref": "#/$defs/result"
        }
      }
    },
    "flag": {
      "type": "object",
      "required": [
        "flag",
        "subject",
        "detail"
      ],
      "additionalProperties": false,
      "properties": {
        "flag": {
          "type": "string",
          "enum": [
            "cannot-fail",
            "control-missed",
            "control-error",
            "fails-at-head",
            "baseline-error",
            "baseline-not-run",
            "same-family",
            "shared-context",
            "stale-import"
          ]
        },
        "subject": {
          "$ref": "#/$defs/id"
        },
        "loud": {
          "type": "boolean"
        },
        "detail": {
          "type": "string"
        }
      }
    },
    "promise": {
      "type": "object",
      "required": [
        "id",
        "label",
        "sentence",
        "claims"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Two to five plain words for the promise chip."
        },
        "sentence": {
          "type": "string",
          "minLength": 1,
          "description": "Strict STE. One plain sentence, with no code name and no ID."
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "reviewer_action": {
          "type": "string",
          "minLength": 1,
          "description": "Strict STE. What a reviewer must do, or not rely on, because the promise is weak. Required when the weakest claim is not Proven."
        }
      }
    },
    "exercise": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "claim",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "trace",
            "close-gap"
          ]
        },
        "claim": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "scenario": {
          "type": "string",
          "description": "trace: the situation to step through."
        },
        "steps": {
          "type": "array",
          "description": "trace: one question per step. The server keeps answer and why.",
          "items": {
            "type": "object",
            "required": [
              "prompt",
              "choices",
              "answer"
            ],
            "additionalProperties": false,
            "properties": {
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "choices": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string"
                }
              },
              "answer": {
                "type": "integer",
                "minimum": 0
              },
              "why": {
                "type": "string"
              }
            }
          }
        },
        "brief": {
          "type": "string",
          "description": "close-gap: what the missing test must check."
        },
        "test_path": {
          "type": "string",
          "minLength": 1,
          "description": "close-gap: the only file the learner can write, relative to the worktree root."
        },
        "starter": {
          "type": "string",
          "description": "close-gap: the first text of the test file."
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "bug": {
          "type": "object",
          "required": [
            "description",
            "edits"
          ],
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1
            },
            "edits": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/edit"
              }
            }
          }
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pattern": {
              "type": "string"
            }
          }
        }
      }
    },
    "invariant": {
      "type": "object",
      "required": [
        "id",
        "text",
        "author",
        "status",
        "candidate"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "enum": [
            "user",
            "agent"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "proposed",
            "rejected",
            "deferred"
          ]
        },
        "candidate": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_prompt": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "shape": {
          "type": "string",
          "enum": [
            "rule",
            "process",
            "input-space",
            "wiring",
            "flow"
          ]
        },
        "frog_ev": {
          "type": "number"
        },
        "possible_bug": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question",
              "expected",
              "got"
            ],
            "properties": {
              "question": {
                "type": "string"
              },
              "expected": {
                "type": "string"
              },
              "got": {
                "type": "string"
              },
              "where": {
                "type": "string"
              }
            }
          }
        },
        "at": {
          "type": "string"
        },
        "owner": {
          "type": "string",
          "description": "Who decides a deferred invariant."
        },
        "deferred": {
          "type": "boolean",
          "description": "The user deferred it. It stays proposed."
        },
        "flag": {
          "type": "string",
          "description": "For example: the open safety question."
        },
        "route": {
          "type": "string",
          "enum": [
            "code-first",
            "model-first",
            "harness-first",
            "theorem-first"
          ]
        },
        "fix_branch": {
          "type": "string"
        },
        "record": {
          "type": "string",
          "description": "The formal record that checks it, for example F489-1."
        },
        "parent": {
          "type": "string"
        }
      }
    }
  }
}
