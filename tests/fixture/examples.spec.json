{
 "examples": [
  {
   "id": "overdraft-before-after",
   "title": "One overdraft, with and without the guard",
   "lead": "A planted bug takes the guard out of the withdraw function, and the test of the PR runs on it. Then the same test runs on the code of the PR. The values are the recorded control run and the calls that the test makes.",
   "diagram": "story",
   "claims": [
    "C01"
   ],
   "sources": {
    "control": {
     "kind": "controls",
     "ids": [
      "K01"
     ]
    },
    "after": {
     "kind": "run",
     "commit": "head",
     "setup": false,
     "argv": [
      "python3",
      "-m",
      "unittest",
      "tests.test_core"
     ],
     "exit": 0,
     "record": [
      {
       "name": "withdraw",
       "target": "wallet.core:withdraw",
       "args": true
      }
     ]
    }
   },
   "steps": [
    {
     "station": "before",
     "name": "Without the guard, the wallet pays out",
     "diff": {
      "path": "/control/K01/patch/0/path",
      "patch": "/control/K01/patch/0/patch"
     },
     "decision": {
      "control result": "/control/K01/result/status"
     },
     "out": {
      "test output": {
       "from": "/control/K01/result/output_tail",
       "lines": [
        -6,
        -5
       ]
      }
     },
     "reason": "The control takes out the line that raises the error. The test asks for more than the balance, and no error comes, so the test fails.",
     "assert": [
      {
       "value": "/control/K01/result/status",
       "equals": "red"
      }
     ]
    },
    {
     "station": "refuse",
     "name": "With the guard, the wallet refuses the overdraft",
     "in": {
      "call": {
       "from": "/after/withdraw",
       "where": {
        "/args/1": 11
       },
       "at": 0,
       "fields": {
        "balance": "/args/0",
        "amount": "/args/1"
       }
      }
     },
     "decision": {
      "error": {
       "from": "/after/withdraw",
       "where": {
        "/args/1": 11
       },
       "at": 0,
       "fields": {
        "raised": "/raised"
       }
      }
     },
     "out": {
      "test exit code": "/after/exit"
     },
     "reason": "The code of the PR compares the amount with the balance first. The amount is above the balance, so the function raises an error and pays out nothing.",
     "code": {
      "path": "wallet/core.py",
      "symbol": "withdraw"
     }
    }
   ]
  },
  {
